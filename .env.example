# ═══════════════════════════════════════════════════
# Network Scanner — Environment Variables
# ═══════════════════════════════════════════════════
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git. Add it to .gitignore.
# ═══════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────
PORT=5000
HOST=0.0.0.0

# ── Twilio WhatsApp Agent ────────────────────────────
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+14155238886     # Your Twilio WhatsApp-enabled number
TWILIO_USE_WHATSAPP=true            # true = WhatsApp, false = SMS

# ── Telegram Bot Agent (FREE) ────────────────────────
# Create a bot via https://t.me/BotFather to get your token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsT...
# Get your Chat ID by messaging https://t.me/userinfobot
TELEGRAM_CHAT_ID=987654321

# ── Root User (Admin) ────────────────────────────────
ROOT_USER_NAME=Admin
ROOT_USER_PHONE=+91xxxxxxxxxx       # Phone number with country code

# ── Discord Webhook (optional) ───────────────────────
WEBHOOK_URL=

# ── Network Scanner Settings ─────────────────────────
NETWORK_INTERFACE=                  # Leave blank for auto-detect (e.g. eth0, wlan0)
TRAFFIC_RETENTION_DAYS=7
PURGE_INTERVAL_HOURS=24
