# ═══════════════════════════════════════════════════════════════════════
# My Network Guard — Environment Variables
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git. Add it to .gitignore.
# All secrets must be injected via environment — never hardcoded.
# ═══════════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────────
PORT=5000
HOST=0.0.0.0

# ── Flask Security ──────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# ── JWT Authentication (Production / Cloud Mode Only) ──────────────────
# Set REQUIRE_AUTH=true to enable JWT authentication (recommended for Render)
REQUIRE_AUTH=false
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ── Admin / Root User ────────────────────────────────────────────────────
ROOT_USER_NAME=
ROOT_USER_PHONE=

# ── Telegram Bot Integration ─────────────────────────────────────────────
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Your personal Telegram Chat ID (get via @userinfobot)
TELEGRAM_CHAT_ID=

# ── Discord / Slack Webhook (optional) ──────────────────────────────────
WEBHOOK_URL=

# ── Network Scanner ──────────────────────────────────────────────────────
# Leave blank for auto-detection (e.g. eth0, wlan0, Wi-Fi)
NETWORK_INTERFACE=
# Simulation mode — no packet capture required (for testing/demo)
SIMULATION_MODE=false

# ── Data Retention ───────────────────────────────────────────────────────
TRAFFIC_RETENTION_DAYS=7
PURGE_INTERVAL_HOURS=24

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Set to "json" for structured logging (cloud log aggregators)
LOG_FORMAT=human
